#!/usr/bin/env bash
# Runs the fast validation tier (T1, ~5 min on CPU) before pushing to develop or master.
# Enable once per clone:   git config core.hooksPath ci/githooks
# Skip for one push:       SAOS_SKIP_CI=1 git push
[ "${SAOS_SKIP_CI:-0}" = "1" ] && exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/develop|refs/heads/master)
            echo "pre-push: running the fast validation tier (SAOS_SKIP_CI=1 to skip)"
            exec "$(git rev-parse --show-toplevel)/ci/run_ci.sh" fast -q ;;
    esac
done
exit 0
